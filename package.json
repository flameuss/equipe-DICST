{
  "name": "ccst-diiav-equipe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Site institucional de equipe do CCST / DIIAV (INPE) gerado automaticamente a partir da planilha 2026-2027 e pasta imagens/",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "npm run build:data",
    "dev": "vite --configLoader native",
    "build:data": "node scripts/build-team-data.mjs",
    "prebuild": "npm run build:data",
    "build": "vite build --configLoader native",
    "preview": "vite preview --configLoader native",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build:data",
    "test": "vitest run --configLoader native",
    "sanitize:xlsx": "node scripts/sanitize-xlsx.mjs",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.17",
    "@astryxdesign/theme-neutral": "^0.7.17",
    "@fontsource/source-sans-3": "^5.3.1",
    "@stylexjs/stylex": "^0.19.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.17",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "jszip": "^3.10.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^5.1.2"
  }
}
